---
import Footer from '@/components/Footer.astro';

import '@/styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Carlos Martínez | k4rlosdev</title>
  </head>
  <body>
    <main id="main-content" class="bg-primary relative z-10">
      <slot />
    </main>
    <Footer />
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      const mainEl = document.getElementById('main-content') as HTMLElement;
      const footerEl = document.querySelector('footer') as HTMLElement;
      const sections = Array.from(
        mainEl?.querySelectorAll(':scope > section') ?? []
      ) as HTMLElement[];
      const panels = sections.map(
        (section: HTMLElement): HTMLElement | null =>
          section.querySelector(':scope > .overlap-panel') as HTMLElement | null
      );
      const media = gsap.matchMedia();

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        lerp: 0.07,
        smoothWheel: true,
        syncTouch: true,
        touchMultiplier: 1.5
      });

      gsap.ticker.add((time: number): void => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      function syncFooterSpace(): void {
        if (!mainEl || !footerEl) return;

        mainEl.style.marginBottom =
          window.innerWidth >= 768 ? `${footerEl.offsetHeight}px` : '0px';
      }

      function resetSections(): void {
        sections.forEach((section: HTMLElement, index: number): void => {
          const panel = panels[index];

          gsap.set(section, {
            clearProps: 'zIndex'
          });

          if (!panel) return;

          gsap.set(panel, {
            clearProps: 'transform,transformOrigin,willChange'
          });
        });
      }

      function initOverlappingSections(): void {
        if (sections.length < 2) return;

        media.add('(min-width: 768px)', (): (() => void) => {
          sections.forEach((section: HTMLElement, index: number): void => {
            const panel = panels[index];

            gsap.set(section, {
              zIndex: index + 1
            });

            if (panel) {
              gsap.set(panel, {
                transformOrigin: 'bottom left',
                willChange: 'transform'
              });

              if (index > 0) {
                gsap.set(panel, { rotation: 12 });
                gsap.to(panel, {
                  rotation: 0,
                  ease: 'none',
                  scrollTrigger: {
                    trigger: section,
                    start: 'top bottom',
                    end: 'top 25%',
                    scrub: true
                  }
                });
              }
            }

            if (index === sections.length - 1) return;

            ScrollTrigger.create({
              trigger: section,
              start: 'bottom bottom',
              end: 'bottom top',
              pin: true,
              pinSpacing: false,
              anticipatePin: 1
            });
          });

          ScrollTrigger.refresh();

          return (): void => {
            resetSections();
          };
        });

        media.add('(max-width: 767px)', (): void => {
          resetSections();
        });
      }

      syncFooterSpace();
      initOverlappingSections();

      window.addEventListener('resize', (): void => {
        syncFooterSpace();
        ScrollTrigger.refresh();
      });
    </script>
  </body>
</html>
