---
import Footer from '@/components/Footer.astro';
import { Font } from 'astro:assets';
import SEO from '@/components/SEO.astro';

import '@/styles/global.css';

interface Props {
  showFooter?: boolean;
  title: string;
  description: string;
  canonical?: string | false;
  noindex?: boolean;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  showFooter = false,
  title,
  description,
  canonical,
  noindex = false,
  image,
  jsonLd
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <Font cssVariable="--font-inter-family" preload />
    <Font cssVariable="--font-russo-one" />
    <Font cssVariable="--font-cloister-black" />
    <title>{title}</title>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      image={image}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <main id="main-content" class="bg-primary relative z-10">
      <slot />
    </main>
    {showFooter && <Footer />}
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      const mainEl = document.getElementById('main-content') as HTMLElement;
      const footerEl = document.querySelector('footer') as HTMLElement;
      const sections = Array.from(
        mainEl?.querySelectorAll(':scope > section') ?? []
      ) as HTMLElement[];
      const panels = sections.map(
        (section: HTMLElement): HTMLElement | null =>
          section.querySelector(':scope > .overlap-panel') as HTMLElement | null
      );

      const media = gsap.matchMedia();

      gsap.registerPlugin(ScrollTrigger);

      media.add('(prefers-reduced-motion: no-preference)', (): (() => void) => {
        const lenis = new Lenis({
          lerp: 0.07,
          smoothWheel: true
        });

        lenis.on('scroll', ScrollTrigger.update);

        const updateLenis = (time: number): void => {
          lenis.raf(time * 1000);
        };

        gsap.ticker.add(updateLenis);
        gsap.ticker.lagSmoothing(0);

        return (): void => {
          gsap.ticker.remove(updateLenis);
          lenis.destroy();
        };
      });

      function syncFooterSpace(): void {
        if (!mainEl || !footerEl) return;

        mainEl.style.marginBottom =
          window.innerWidth >= 768 ? `${footerEl.offsetHeight}px` : '0px';
      }

      function resetSections(): void {
        sections.forEach((section: HTMLElement, index: number): void => {
          const panel = panels[index];

          gsap.set(section, {
            clearProps: 'zIndex'
          });

          if (!panel) return;

          gsap.set(panel, {
            clearProps: 'transform,transformOrigin,willChange'
          });
        });
      }

      function initOverlappingSections(): void {
        if (sections.length < 2) return;

        media.add(
          '(min-width: 768px) and (prefers-reduced-motion: no-preference)',
          (): (() => void) => {
            sections.forEach((section: HTMLElement, index: number): void => {
              const panel = panels[index];

              gsap.set(section, {
                zIndex: index + 1
              });

              if (panel) {
                gsap.set(panel, {
                  transformOrigin: 'bottom left',
                  willChange: 'transform'
                });

                if (index > 0) {
                  gsap.set(panel, { rotation: 12 });
                  gsap.to(panel, {
                    rotation: 0,
                    ease: 'none',
                    scrollTrigger: {
                      trigger: section,
                      start: 'top bottom',
                      end: 'top 25%',
                      scrub: true
                    }
                  });
                }
              }

              if (index === sections.length - 1) return;

              ScrollTrigger.create({
                trigger: section,
                start: 'bottom bottom',
                end: 'bottom top',
                pin: true,
                pinSpacing: false,
                anticipatePin: 1
              });
            });

            ScrollTrigger.refresh();

            return (): void => {
              resetSections();
            };
          }
        );

        media.add(
          '(max-width: 767px), (prefers-reduced-motion: reduce)',
          (): void => {
            resetSections();
          }
        );
      }

      syncFooterSpace();
      initOverlappingSections();

      window.addEventListener('resize', (): void => {
        syncFooterSpace();
        ScrollTrigger.refresh();
      });
    </script>
  </body>
</html>
